<?xml version="1.0"?>
<!--
    `etc/adminhtml/system.xml` has always declared
    `<resource>ReferralCandy_Integration::config</resource>` for its section, but the
    resource itself was never defined. An undefined ACL resource cannot be granted to
    an admin role, so only a superuser could see the ReferralCandy configuration at
    all, and Magento logged the reference as invalid.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="ReferralCandy_Integration::config" title="ReferralCandy" translate="title" sortOrder="500"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
